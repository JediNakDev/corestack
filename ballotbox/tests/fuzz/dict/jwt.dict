j_alg="\"alg\""
j_typ="\"typ\""
j_hs256="\"HS256\""
j_jwt="\"JWT\""
j_none="\"none\""
j_sub="\"sub\""
j_name="\"name\""
j_iat="\"iat\""
j_exp="\"exp\""
brace_open="{"
brace_close="}"
b64_pad="="
