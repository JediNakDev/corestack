eq="="
eq_spaced=" = "
comment="#"
newline="\x0a"
path_directive="PATH="
path_spaced="PATH = "
pathetic="PATHETIC"
k_level="fuzz_level="
k_attempts="fuzz_attempts="
k_queue="fuzz_queue="
k_enabled="fuzz_enabled="
k_path="fuzz_path="
k_host="fuzz_host="
k_facility="fuzz_facility="
k_checked="fuzz_checked="
v_on="on"
v_off="off"
v_yes="yes"
v_no="no"
v_true="true"
v_false="false"
v_one="1"
v_zero="0"
v_daemon="daemon"
v_local0="local0"
n_big="4294967296"
n_neg="-1"
